# .NET 10 LTS, built on the matching supported Ubuntu runtime.
FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build
WORKDIR /src
COPY AgOpenNtripCaster.Server ./AgOpenNtripCaster.Server
RUN dotnet publish AgOpenNtripCaster.Server -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/logs /app/data-protection-keys /backups \
    && chown -R "$APP_UID:$APP_UID" /app/logs /app/data-protection-keys /backups
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:5000 ASPNETCORE_ENVIRONMENT=Production
USER $APP_UID
EXPOSE 5000 2101
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:5000/api/health || exit 1
ENTRYPOINT ["dotnet", "AgOpenNtripCaster.Server.dll"]
